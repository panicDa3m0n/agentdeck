{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "SendMessage",
      "mcp__deck"
    ],
    "deny": [
      "Bash(*systemctl stop sshd*)",
      "Bash(*systemctl disable sshd*)",
      "Bash(*systemctl mask sshd*)",
      "Bash(*systemctl stop systemd-networkd*)",
      "Bash(*systemctl disable systemd-networkd*)",
      "Bash(*systemctl stop iwd*)",
      "Bash(*systemctl disable iwd*)",
      "Bash(*systemctl stop systemd-resolved*)",
      "Bash(*systemctl stop dbus*)",
      "Bash(*agentdeck-deny-canary*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "/usr/bin/python3 /opt/agentdeck/claude/session_start.py"}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__deck__.*",
       "hooks": [{"type": "command", "command": "/usr/bin/python3 /opt/agentdeck/claude/guard.py"}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "/usr/bin/python3 /opt/agentdeck/claude/turn.py"}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
       "hooks": [{"type": "command", "command": "/usr/bin/python3 /opt/agentdeck/claude/after.py"}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "/usr/bin/python3 /opt/agentdeck/claude/session_end.py", "timeout": 10}]}
    ]
  }
}
