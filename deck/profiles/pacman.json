{
  "program": "pacman",
  "description": "Arch Linux package manager. Questions before installing, removing, replacing packages, importing keys and cleaning the cache. snap-pac takes a snapshot before and after every transaction. Profile shipped with deck (docs/adattatore.md).",
  "author": "agent (O10.T7)",
  "questions": [
    {"id": "proceed", "pattern": ":: Proceed with (?P<what>installation|download)\\? \\[Y/n\\]", "type": "confirm", "default": "y",
     "options": [{"key": "y", "label": "yes"}, {"key": "n", "label": "no"}]},
    {"id": "remove", "pattern": ":: Do you want to remove these packages\\? \\[Y/n\\]", "type": "confirm", "default": "y",
     "options": [{"key": "y", "label": "yes"}, {"key": "n", "label": "no"}]},
    {"id": "replace", "pattern": ":: Replace (?P<old>\\S+) with (?P<new>\\S+)\\? \\[Y/n\\]", "type": "confirm", "default": "y",
     "options": [{"key": "y", "label": "yes"}, {"key": "n", "label": "no"}]},
    {"id": "conflict", "pattern": ":: (?P<a>\\S+) and (?P<b>\\S+) are in conflict.*Remove (?P<remove>\\S+)\\? \\[y/N\\]", "type": "confirm", "default": "n",
     "options": [{"key": "y", "label": "yes"}, {"key": "n", "label": "no"}]},
    {"id": "import_key", "pattern": ":: Import PGP key (?P<key>\\S+), .*\\? \\[Y/n\\]", "type": "confirm", "default": "y",
     "options": [{"key": "y", "label": "yes"}, {"key": "n", "label": "no"}]},
    {"id": "provider", "pattern": "Enter a number \\(default=(?P<default>\\d+)\\):", "type": "choice",
     "options_pattern": "(?P<key>\\d+)\\) (?P<label>\\S+)"},
    {"id": "clean_cache", "pattern": "Do you want to remove (?P<what>ALL files|all other packages) from cache\\? \\[(?P<choices>[yYnN]/[yYnN])\\]", "type": "confirm",
     "options": [{"key": "y", "label": "yes"}, {"key": "n", "label": "no"}]}
  ],
  "parse": [
    {"name": "packages", "pattern": "^Packages \\((?P<count>\\d+)\\) (?P<list>.+)$"},
    {"name": "download_size", "pattern": "^Total Download Size:\\s+(?P<value>[\\d.]+ \\S+)"},
    {"name": "installed_size", "pattern": "^Total Installed Size:\\s+(?P<value>[\\d.]+ \\S+)"},
    {"name": "net_upgrade_size", "pattern": "^Net Upgrade Size:\\s+(?P<value>-?[\\d.]+ \\S+)"},
    {"name": "removed_size", "pattern": "^Total Removed Size:\\s+(?P<value>[\\d.]+ \\S+)"},
    {"name": "errors", "pattern": "^error: (?P<message>.+)$", "all": true},
    {"name": "warnings", "pattern": "^warning: (?P<message>.+)$", "all": true}
  ]
}
